      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
